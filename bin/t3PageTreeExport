#!/usr/bin/env php
<?php

declare(strict_types=1);

$baseDir = $_composer_autoload_path
    ?? dirname(__DIR__, 2);
    
require $baseDir . '/autoload.php';
use AgentMedia\T3LocalCopy\Export\ExportCommand;

$command = null;
try {
    $command = new ExportCommand(__DIR__);
    $command->execute();
} catch (\Exception $e) {
    echo "Error: " . $e->getMessage() . "\n";
    if ($command) {
        $command->showHelp();
    }
}