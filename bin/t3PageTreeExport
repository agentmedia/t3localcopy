#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';
use AgentMedia\T3LocalCopy\Export\ExportCommand;

$command = null;
try {
    $command = new ExportCommand(__DIR__);
    $command->execute();
} catch (\Exception $e) {
    echo "Error: " . $e->getMessage() . "\n";
    if ($command) {
        $command->showHelp();
    }
}