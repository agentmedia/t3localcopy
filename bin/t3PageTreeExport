#!/usr/bin/env php
<?php

declare(strict_types=1);

use AgentMedia\T3LocalCopy\Export\ExportCommand;

$autoloadPath = $_composer_autoload_path
    ?? dirname(__DIR__, 2) . '/autoload.php';

$binDir = $_composer_bin_dir ?? __DIR__;

require $autoloadPath;

$command = null;
try {
    $command = new ExportCommand($binDir);
    $command->execute();
} catch (\Exception $e) {
    echo "Error: " . $e->getMessage() . "\n";
    if ($command) {
        $command->showHelp();
    }
}